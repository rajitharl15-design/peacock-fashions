# Postgres connection used by the Peacock backend.
DATABASE_URL=postgres://user:password@host:5432/database

# Schema that holds Peacock's own tables (catalog, orders, admin_settings).
DB_SCHEMA=peacock

# Optional. Set to 1/true or 0/false to force TLS on/off; otherwise auto-probed.
# DB_SSL=1

# Long random value used to sign admin session tokens.
# If unset, a secret is generated and stored in the database on first admin setup.
AUTH_SECRET=

# Where uploaded product images are stored and served from.
# On Render with a disk mounted at /data use: UPLOAD_DIR=/data
UPLOAD_DIR=

# Optional env-based admin login. If omitted, create the admin at /admin-login
# on first visit (stored in the database).
# ADMIN_USER=
# ADMIN_PASS=

# Optional. Only needed if the frontend is hosted on a different origin.
# CORS_ORIGIN=https://peacock.raajicollections.com
